DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=*

DATABASE_URL=postgres://fivuza:password@localhost:5433/fivuza_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173
# Origenes del ERP de cualquier tenant (ej. tenant1.localhost:5173) -no se
# puede fijar una lista exacta porque cada negocio tiene su propio subdominio.
CORS_ALLOWED_ORIGIN_REGEXES=^http://([a-z0-9-]+\.)?localhost:5173$

SENTRY_DSN=
SENTRY_ENVIRONMENT=development

AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION=us-east-1

# En dev, deja EMAIL_BACKEND vacio (usa la consola). En produccion:
# EMAIL_BACKEND=django_ses.SESBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-responder@fivuza.com
FRONTEND_SCHEME=http
FRONTEND_PORT=5173
