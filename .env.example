DEBUG=True
AUTH_COOKIE_SECURE=False
# Obligatoria con DEBUG=False (produccion). En desarrollo puede quedar vacia.
SECRET_KEY=
ALLOWED_HOSTS=*
# Produccion: origenes https desde los que se envian formularios con CSRF
# (admin de Django). Ej: https://*.fivuza.com
CSRF_TRUSTED_ORIGINS=

DATABASE_URL=postgres://fivuza:password@localhost:5433/fivuza_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# Solo desarrollo: en produccion el frontend llama a la API por el mismo
# origen (nginx) y CORS no interviene.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Origenes del ERP de cualquier tenant (ej. tenant1.localhost:5173) -no se
# puede fijar una lista exacta porque cada negocio tiene su propio subdominio.
CORS_ALLOWED_ORIGIN_REGEXES=^http://([a-z0-9-]+\.)?localhost:5173$

SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# API REST de Sentry (lectura), no el DSN de arriba (envio) -para el panel
# de salud por tenant (Sprint 11). Si se dejan vacios, ese panel simplemente
# reporta 0 errores en vez de fallar.
SENTRY_API_TOKEN=
SENTRY_ORG_SLUG=
SENTRY_PROJECT_SLUG=

# Almacenamiento de objetos (respaldos, imagenes, comprobantes). Cualquier
# bucket S3-compatible: en Railway, el endpoint del bucket del proyecto.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# path para proveedores S3-compatibles que no soportan virtual-host.
AWS_S3_ADDRESSING_STYLE=virtual
# Base publica para mostrar imagenes/comprobantes (CDN o bucket publico).
MEDIA_PUBLIC_BASE_URL=

# En dev, deja EMAIL_BACKEND vacio (usa la consola). En produccion:
# EMAIL_BACKEND=django_ses.SESBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-responder@fivuza.com
FRONTEND_SCHEME=http
FRONTEND_PORT=5173

# Opcionales
LOG_LEVEL=INFO
DB_CONN_MAX_AGE=60
# THROTTLE_ENABLED=True
