{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["**/*.py", "requirements.txt", "Dockerfile", "**/templates/**"]
  },
  "deploy": {
    "startCommand": "celery -A config worker -l info --concurrency ${CELERY_CONCURRENCY:-2}",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
